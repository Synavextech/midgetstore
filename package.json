{
  "name": "my_store",
  "version": "1.0.0",
  "description": "E-commerce monorepo with React frontend and Node.js backend",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "dev:server": "nodemon",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "cd server && npx tsc",
    "start": "npm run start:client && npm run start:server",
    "start:client": "vite preview",
    "start:server": "cd server && tsx dist/index.js",
    "clean": "rm -rf dist && cd server && rm -rf dist",
    "admin:create": "node create-admin.js"
  },
  "type": "module",
  "dependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.52.4",
    "@stripe/react-stripe-js": "^2.1.0",
    "@stripe/stripe-js": "^1.52.0",
    "@supabase/supabase-js": "^2.117.3",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.8",
    "@types/pg": "^8.23.1",
    "axios": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "helmet": "^6.0.0",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.263.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9",
    "paypal-rest-sdk": "^1.8.1",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "stripe": "^12.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.2",
    "vite": "^7.1.9"
  }
}
